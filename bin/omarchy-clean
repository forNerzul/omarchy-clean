#!/usr/bin/env python3
import os
import sys

LAYER_SHELL = "libgtk4-layer-shell.so"

# gtk4-layer-shell must be linked before libwayland-client.
preload = os.environ.get("LD_PRELOAD", "")
if LAYER_SHELL not in preload:
    env = dict(os.environ)
    env["LD_PRELOAD"] = ":".join(p for p in (f"/usr/lib/{LAYER_SHELL}", preload) if p)
    os.execve(sys.executable, [sys.executable, *sys.argv], env)

sys.path.insert(0, os.path.join(os.path.dirname(os.path.realpath(__file__)), "..", "src"))

from omarchy_clean import overlay  # noqa: E402

sys.exit(overlay.main())

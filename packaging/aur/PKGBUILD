# Maintainer: Sergio Javier Garcia Martinez <sbeardman92 at gmail dot com>
pkgname=omarchy-clean
pkgver=0.1.0
pkgrel=1
pkgdesc="Lock keyboard, touchpad and system keys while cleaning a laptop on Omarchy (Hyprland)"
arch=('any')
url="https://github.com/forNerzul/omarchy-clean"
license=('MIT')
depends=('python' 'python-evdev' 'python-gobject' 'gtk4' 'gtk4-layer-shell'
         'polkit' 'hyprpolkitagent' 'hyprland')
install=omarchy-clean.install
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('e233bb298ab08f575b84836031847d64d0e25aa5b35be7817073c46fc58283de')

check() {
  cd "$srcdir/$pkgname-$pkgver"
  make test
}

package() {
  cd "$srcdir/$pkgname-$pkgver"
  make DESTDIR="$pkgdir" PREFIX=/usr install
  # Pre-compile so the root helper never writes __pycache__ into /usr.
  python -m compileall -q -d /usr/lib/omarchy-clean/src "$pkgdir/usr/lib/omarchy-clean/src"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
